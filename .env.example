# Copy this file to .env and fill in your keys.
# Sleeper itself needs no key — its public API is used for roster/league sync.

# Quant / VORP Specialist + Debate Moderator
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Beat / News Tracker (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Contrarian / Risk Analyst
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
