.env
__pycache__/
*.pyc
.venv/
venv/

# Local caches / paid data / chat memory — never commit these
data/sleeper_snapshots/*.json
# Draft Sharks data lives per-league under data/projections/<league_id>/
data/projections/**/*.csv
data/projections/**/*.json
data/projections/**/*.pdf
data/chats/*.json
data/decisions/*.json
data/last_session.json
data/league_prefs.json
data/player_aliases.json
data/league_formats.json
data/attachments/*
# Draft simulation trial output -- regenerated by run_draft_validation.py /
# run_counterfactual_analysis.py, not source
data/draft_simulation_trials/*.json
data/draft_simulation_trials/**/*.json
# #150's battery output -- a MEASUREMENT regenerated by run_draft_battery.py, not source, and
# the same class as the trial output above. Deliberately untracked: a committed report is read
# as a reference, and this one is only true of the tree and the ranking export it ran against.
BATTERY_REPORT.json

.streamlit/secrets.toml

# store_io's lock sidecars and its in-flight temp files. Both are runtime artifacts of the
# read-modify-write discipline (#102), never content: a .lock file is an empty inode that exists
# only to hold an OS lock, and a .tmp-<pid> is a write in progress that os.replace is about to
# rename away. Committing either would ship one machine's transient state as source.
*.json.lock
*.json.tmp-*
evidence/roster_shape/ff_rulebook/ktc_sign_probe.pdf

# invariant_confirmation.py's restore copy. The harness writes
# `path.with_suffix(path.suffix + ".confirm_backup")` before rewriting a source file with a
# deliberate break, then restores from it. While a run is in flight the ORIGINAL sits here and
# the tracked file is a mutant, so an untracked `draft_room.py.confirm_backup` showing as `??`
# is one `git add -A` away from being committed alongside a knowingly broken engine -- the #169
# staging family with a new cause. Same class as the store_io sidecars above: a runtime artifact
# of a discipline, never content.
*.py.confirm_backup
