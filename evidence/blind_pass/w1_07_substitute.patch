+def max_intervening_gap(pick_order: list, roster_id) -> Optional[int]:
+    """The largest gap between two consecutive selections by `roster_id` in THIS pick order.
+
+    The normaliser for the urgency term, derived from the order the draft actually has rather
+    than from 2*(teams-1) -- which is right for a standard snake and wrong for a third-round
+    reversal or any other shape a commissioner can configure. For a 12-team snake the two agree
+    at 22; that agreement is a check on this function, not its definition.
+
+    None when this roster has fewer than two selections left to compare, because there is then
+    no gap to normalise against and a substituted number would be invented.
+    """
+    mine = [i for i, owner in enumerate(pick_order or []) if str(owner) == str(roster_id)]
+    if len(mine) < 2:
+        return None
+    return max(b - a - 1 for a, b in zip(mine, mine[1:])) or None
+
